# AIの利用について:
# チャット回答・登録内容の解析は Claude Agent SDK（Claude Codeのライブラリ版）経由で行います。
# ANTHROPIC_API_KEY は不要です。代わりに、このアプリを動かすマシン/サーバー上で
# 事前に `claude login` を実行し、Claude Codeにログイン（サブスクリプション認証）しておいてください。

# ── Supabase ────────────────────────────────────────────────
# ローカルで動かす場合は `supabase start` が表示する値をそのまま使います。
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=（start の出力の ANON_KEY）
#   SUPABASE_SERVICE_ROLE_KEY=（start の出力の SERVICE_ROLE_KEY）
#
# クラウドのプロジェクトに繋ぐ場合は Project Settings > API の値を入れます。
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー側だけで使う鍵。RLSを通さないので、絶対に公開しないこと。
# アカウント削除・利用停止・シード投入にだけ使っています。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
