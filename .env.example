# このファイルを .env.local にコピーして、公開できない鍵を埋めてください。
#
#   cp .env.example .env.local
#
# Supabase の URL と anon キーは、リポジトリの .env に入っているので設定不要です。
# 自分のSupabaseプロジェクトに繋ぐ場合だけ、ここに上書きで書きます。
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase ダッシュボード > Project Settings > API > service_role の値。
# RLSを無視できる強い鍵なので、リポジトリやチャットに貼らないこと。
# アプリでは、経験値の加算・メンバー管理・アカウント削除・シード投入に使っています。
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console (https://console.anthropic.com/) で発行したAPIキー。
# チャット回答・資料の読み取り・メモの要約に使います。従量課金なので漏らさないこと。
ANTHROPIC_API_KEY=
