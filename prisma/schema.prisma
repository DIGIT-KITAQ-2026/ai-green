generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 所属チーム（所属選択画面 / 業務内容の分類に使用）
model Team {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  users       User[]
  entries     TaskEntry[]
  events      Event[]
  sharedNotes SharedNote[]
}

// ユーザー（新人 / 先輩・管理者）
model User {
  id           String   @id @default(cuid())
  loginId      String   @unique // ログインID（社員ID・メールアドレス等）
  passwordHash String
  name         String
  nickname     String? // 呼び方（マスコットがユーザーを呼ぶ名前）
  role         String   @default("member") // "member" | "admin"
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())

  // 育成要素。質問・ToDo消化・業務内容の登録で貯まる（src/lib/rewards.ts）。
  xp               Int     @default(0)
  // 選択中のキャラクター／着せ替え。ID は rewards.ts のカタログを指す。
  selectedRewardId String?

  entries       TaskEntry[]
  chatMessages  ChatMessage[]
  conversations Conversation[]
  events        Event[]
  todos         Todo[]
  notes         Note[]
  sharedNotes   SharedNote[]
}

// チャットの会話（スレッド）。過去の会話を残したまま新しい会話を始められるようにする。
model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String // 最初の質問から自動で付ける見出し
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // 一覧を新しい順に並べるために使う

  messages   ChatMessage[]
  sharedNote SharedNote?

  @@index([userId, updatedAt])
}

// 業務内容のエントリ（登録画面から作成、業務内容画面に一覧表示）。
// もとは「業務内容」と「マニュアル」に分かれていたが、機能が同じだったため統合した。
model TaskEntry {
  id          String   @id @default(cuid())
  title       String
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  summary     String // AIが生成した要約（一覧・チャット回答で使用）
  rawText     String // 添付ファイルから抽出したテキスト全文（検索対象）
  // 退会しても資料はチームに残すため、登録者は任意にしている（退会時は null）。
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  attachments Attachment[]
}

// アップロードされた画像・PDF（業務内容登録 / チャット添付の両方で使用）
model Attachment {
  id            String       @id @default(cuid())
  kind          String // "image" | "pdf"
  filename      String
  mimeType      String
  data          Bytes // ファイル本体（SQLiteに直接保存）
  ocrText       String? // このファイル単体から抽出したテキスト
  taskEntryId   String?
  taskEntry     TaskEntry?   @relation(fields: [taskEntryId], references: [id])
  chatMessageId String?
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id])
  createdAt     DateTime     @default(now())
}

// チャットのメッセージ（新人の質問 / AIの回答）
model ChatMessage {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  conversationId        String
  conversation          Conversation  @relation(fields: [conversationId], references: [id])
  role                  String // "user" | "assistant"
  text                  String
  referencedTaskEntryId String? // AIが回答の根拠にした業務内容ID
  createdAt             DateTime @default(now())

  attachments Attachment[]
}

// カレンダーの予定。チーム単位で共有し、研修や締め日、定例会議などを置く。
model Event {
  id          String   @id @default(cuid())
  title       String
  // 日付のみを扱う（時刻は startTime に文字列で持たせ、未入力なら終日扱い）。
  date        DateTime
  startTime   String? // "09:30" 形式。未入力なら終日の予定
  note        String?
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  // 退会しても予定はチームに残すため、登録者は任意にしている（退会時は null）。
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([teamId, date])
}

// ToDo。新人が自分のやることを管理するため、ユーザーごとに持つ。
model Todo {
  id          String    @id @default(cuid())
  title       String
  dueDate     DateTime? // 期限（任意）
  done        Boolean   @default(false)
  completedAt DateTime?
  // 経験値は最初に完了したとき1回だけ付ける（チェックし直しで増えないように）。
  xpAwarded   Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([userId, done, dueDate])
}

// メモ。新人が気づいたことをその場で書き留めるためのもの。ユーザーごとに持つ。
model Note {
  id        String   @id @default(cuid())
  title     String
  body      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// チャットのやり取りをAIが要約し、チームの共有ナレッジとして残したもの。
// 個人の Note と違い、同じチームの全員が読める。
model SharedNote {
  id    String @id @default(cuid())
  title String
  body  String // AIが作った要約（質問と答えを新人にも分かる形にまとめたもの）

  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  // 退会しても共有ナレッジはチームに残すため、作成者は任意。
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  // 元になった会話。同じ会話を二重に共有しないよう一意にしている。
  // 会話が削除されたら null になり、メモ自体はチームに残る。
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  // 回答の根拠になった業務内容。読んだ人が原典に当たれるようにする。
  referencedTaskEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId, createdAt])
}
